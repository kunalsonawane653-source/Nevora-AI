        "condition": "Renal Health (Chronic)",
        "stage": "Healthy",
        "status": "Stable",
        "actions": []
    }

    # Extracting GFR (Glomerular Filtration Rate) and Creatinine
    gfr_value = vitals_input.get("gfr", 100)
    creatinine = vitals_input.get("creatinine", 1.0)

    # Symptoms list from Image 81 & 82
    renal_failure_signs = {
        "swelling_feet_ankles", "shortness_of_breath", "nausea_vomiting",
        "decreased_urine_output", "fatigue_weakness", "persistent_itching",
        "fluid_retention", "chest_pain"
    }

    # Classification logic based on GFR (Image 83)
    if gfr_value < 15:
        result["stage"] = "STAGE 5 (Kidney Failure)"
        result["status"] = "CRITICAL - DIALYSIS REQUIRED"
    elif gfr_value < 30:
        result["stage"] = "STAGE 4 (Severe Damage)"
