        result.update({
            "condition": "HEART ATTACK SUSPECTED",
            "status": status_level,
            "actions": [
                "1. IMMEDIATE ACTION: Call for an ambulance or emergency medical team.",
                "2. POSITION: Keep the patient sitting down and calm to reduce heart strain.",
                "3. ASPIRIN: If recommended by a doctor, give one 325mg Aspirin to chew (if not allergic).",
                "4. DIAGNOSIS: Perform an immediate ECG (Electrocardiogram) to check heart rhythm.",
                "5. LABS: Check Cardiac Troponin levels in the blood.",
                "6. CPR/AED: If the patient becomes unconscious and has no pulse, start CPR immediately."
            ]
        })

        if is_high_risk:
            result["actions"].insert(0, "CRITICAL: Severe chest pressure and cold sweat detected. Time is Muscle - Get to a hospital NOW.")

    return result

