    Focuses on chest pain, radiating pain, and heart rate.
    """
    result = {
        "condition": "Cardiovascular Monitoring",
        "status": "Stable",
        "actions": []
    }

    # Core Symptoms of Heart Attack
    cardiac_triggers = {
        "chest_pain_pressure", "pain_radiating_to_left_arm", "pain_in_jaw_back",
        "excessive_sweating", "shortness_of_breath", "nausea_dizziness",
        "heart_palpitations", "extreme_anxiety"
    }

    # Extracting Heart Rate and BP
    heart_rate = vitals_input.get("heart_rate", 72)
    systolic_bp = vitals_input.get("systolic_bp", 120)

    # Detection logic
    is_high_risk = "chest_pain_pressure" in symptoms_input and "excessive_sweating" in symptoms_input
    
    if symptoms_input.intersection(cardiac_triggers) or heart_rate > 100 or heart_rate < 50:
